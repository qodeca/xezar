{
  "version": 1,
  "baseBranch": "auto",
  "tracker": "github",
  "browser": {
    "provider": "agent-browser"
  },
  "validation": {
    "commands": [
      "npm run typecheck",
      "npm test",
      "npm run test:unit",
      "npm run build",
      "npm run test:package"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "merge-queue"
    ],
    "category": [
      "bug",
      "enhancement",
      "refactor",
      "testing",
      "documentation"
    ],
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress"
    ],
    "priority": [
      "priority-high"
    ],
    "risk": [
      "risk-high"
    ]
  },
  "qaGate": true,
  "paths": {
    "runs": ".local/runs",
    "analysis": ".local/analysis",
    "specs": "docs/features",
    "scripts": "scripts",
    "qa": ".local/qa"
  },
  "reviewChecklist": null
}
