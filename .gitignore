node_modules/
dist/
# test-coverage output — generated, and kept out of the autosave's `git add -A` commits
coverage/
*.tsbuildinfo
.idea

# Build artifact: the one README lives at the repo root and is copied into the published
# package by packages/xezar/scripts/sync-readme.mjs. Never edit the copy.
/packages/xezar/README.md

# Xezar single-project files hold this machine's workspace and agent-login folders.
# They stay local; the rest of .xezar/ is not ignored as a whole.
/.xezar/workspace.json
/.xezar/workspace.json.*
/.xezar/workspace-ui.json
/.xezar/agent-accounts.json

# The same state under the names Cezar used before the rename. A developer who ran Cezar in
# this checkout still has these directories, and the rename moved the ignore rules off them —
# which is exactly how four local-state files reached a commit once. They are not ours to
# publish and not ours to delete, so they are ignored under BOTH names, permanently.
.ai/cezar/
.ai/qa/cez-home/

# locally installed agent skills (per-machine installs, not repo content). The skills lock file
# is ignored by the xezar-onboarding block at the end of this file.
.agents/

# Agent-pipeline working records. These are per-run logs, handoffs, design drafts and
# checkpoint screenshots — useful on the machine that produced them, noise in a public
# repository. They were removed from the tree with the Xezar rename and stay local from now on.
.ai/runs/
.ai/specs/
.ai/analysis/

# agent-pipeline scratch state (worktrees and other per-run working files)
.ai/tmp/

# Claude Code keeps per-machine state under .claude/ (locks, worktrees, checkpoints, settings.local.json,
# installed skills). Only the shared .claude/settings.json is tracked; everything else stays local.
# The project's own skills live in .xezar/skills, not here. packages/xezar/src/tracked-files.test.ts
# fails on any other tracked .claude/ path.
.claude/*
!.claude/settings.json

# mock-agent output from dry-run e2e (packages/xezar/scripts/mock-claude.mjs appends here)
/notes.md

# macOS finder metadata
.DS_Store

# local environment file — may hold tokens
.env

# local agent scratch — investigation notes, evidence, drafts
/.local/

# Legacy QA contains only local data; new producers use .local/qa. This one rule covers everything
# that used to be listed under .ai/qa/ one by one: per-run artifacts_*/, test-env.json and
# test-env.lock/, every *.log an agent parks there (a narrower `test-env-*.log` once let a hand-named
# boot log reach a commit), .build-cache and xez-home/. It also covers agent-home/, the empty
# agent-config sandbox that test-env-up.sh pointed CLAUDE_CONFIG_DIR and CODEX_HOME at. That one is
# credential-adjacent: a login run while that env is active writes real tokens there. It is guarded
# by the stateDirs check in packages/xezar/src/tracked-files.test.ts as well as by this rule.
/.ai/qa/

# xezar-onboarding: start — the xez-* skills are installed per machine, never committed.
# No trailing slash: the .claude/skills entries are links, and a slash pattern does not match a link.
/.agents/skills/xez-*
/.claude/skills/xez-*
/skills-lock.json
# xezar-onboarding: end
