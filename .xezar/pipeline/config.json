{
  "baseBranch": "develop",
  "tracker": "github",
  "browser": {
    "provider": "chrome-devtools"
  },
  "validation": {
    "commands": [
      "npm run typecheck",
      "npm test",
      "npm run test:unit",
      "npm run build",
      "npm run test:package"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge",
      "design",
      "design-failed"
    ],
    "category": [
      "bug",
      "feature",
      "refactor",
      "security",
      "dependencies",
      "documentation"
    ],
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring",
      "needs-design",
      "design-approved",
      "skip-design"
    ],
    "priority": [
      "priority-low",
      "priority-medium",
      "priority-high",
      "priority-extreme"
    ],
    "risk": [
      "risk-low",
      "risk-medium",
      "risk-high"
    ],
    "platform": ["windows", "linux", "macos"]
  },
  "qaGate": true,
  "ci": {
    "requiredChecks": [
      "Typecheck, unit tests, build, and package",
      "MCP per-file coverage",
      "Hosted server boundary and proxy",
      "Two-project product harness",
      "Cockpit browser e2e"
    ],
    "maxWaitMinutes": 45
  },
  "gates": {
    "requireVerdictHead": true,
    "designGate": true
  },
  "toolchain": {
    "providers": [
      "npm"
    ]
  },
  "paths": {
    "qa": ".local/xezar/qa",
    "designSystem": "docs/design-system",
    "designs": "designs",
    "architecture": "docs/architecture",
    "spikes": "docs/spikes",
    "runbooks": "docs/runbooks",
    "deprecations": "docs/deprecations",
    "performance": "docs/performance",
    "migrations": "docs/migrations"
  },
  "deploy": {
    "environments": [],
    "rollback": []
  },
  "performance": {
    "budgets": []
  },
  "localisation": {
    "locales": []
  },
  "security": {
    "trustBoundaries": [
      {
        "pattern": "packages/xezar/src/server/**",
        "why": "The HTTP surface: loopback and origin guards, the bind host."
      },
      {
        "pattern": "packages/xezar/src/mcp/**",
        "why": "The leader's tools and session binding."
      },
      {
        "pattern": "packages/xezar/src/agent-config/**",
        "why": "The agents' own config files."
      },
      {
        "pattern": "packages/xezar/src/workspace/**",
        "why": "Per-user state and the project registry."
      },
      {
        "pattern": "scripts/xezar-leader.sh",
        "why": "Starts the project leader session and lets the engine push events into it."
      },
      {
        "pattern": "scripts/xezar-leader-settings.json",
        "why": "The leader session's permissions, including its right to merge pull requests."
      },
      {
        "pattern": "packages/xezar/src/core/secret-redaction.ts",
        "why": "Scrubs credentials from run transcripts and state before they reach disk or the API."
      },
      {
        "pattern": "packages/xezar/src/core/agent-env.ts",
        "why": "The least-privilege environment every agent backend starts with; decides which host secrets a run can see."
      },
      {
        "pattern": "packages/xezar/src/core/read-only-lock.ts",
        "why": "The read-only policy the agent hooks enforce; decides which commands a read-only step may run."
      },
      {
        "pattern": "packages/xezar/scripts/*-hook.mjs",
        "why": "The shipped read-only hook bundles and the scripts that build them; the Codex bundle's bytes are trusted by hash in users' profiles."
      },
      {
        "pattern": "packages/xezar/scripts/check-pack.mjs",
        "why": "The check that decides what the published npm archive may contain."
      }
    ]
  }
}
