# xezar environment variables — copy to `.env` and adjust. Every var is optional;
# the defaults give a zero-config local cockpit. xezar reads these from the process
# environment (it does not auto-load `.env` — export them, or use your shell/dotenv).

# ---- deployment mode --------------------------------------------------------
# Local (default) exposes host-only conveniences: "open in editor/Finder/terminal",
# worktree-path handoff, the launch bookmarklet. Set to 1 for VPS / hosted mode to
# hide those host-machine affordances (the cockpit is being viewed over the network).
# The Add project browser is always confined to XEZ_BROWSE_ROOT (default `~/`); set that
# root narrowly for a hosted cockpit if the remote viewer should not enumerate the whole home.
# XEZ_REMOTE=1

# ---- dev launcher (scripts/dev.mjs) -----------------------------------------
# Port the Vite dev server proxies /api to (default 4321). The server does not read it.
# `npm run dev` probes a free port, passes it to the server as --port and overwrites
# this variable for Vite. Set it only when running `npm run dev:web` against a server
# you started on another port.
# XEZ_API_PORT=4321

# ---- agent CLIs -------------------------------------------------------------
# Override the discovered path to each backend CLI (defaults: found on PATH).
# XEZ_CLAUDE_BIN=/usr/local/bin/claude
# XEZ_CODEX_BIN=/usr/local/bin/codex
# XEZ_OPENCODE_BIN=/usr/local/bin/opencode
# XEZ_PI_BIN=/usr/local/bin/pi

# The reasoning summary Codex is asked for on each turn (`auto`, `concise`, `detailed`,
# or `none` to opt out). Defaults to `auto` so the reasoning thread is visible out of
# the box; an unrecognised value falls back to `auto`.
# XEZ_CODEX_REASONING=auto

# The agents' OWN home variables (not xezar's) are honoured where the vendor documents one:
# setting one here moves that agent's DEFAULT account — the one xezar discovers. A SECOND login of
# the same CLI is deliberately NOT configured through the environment, because a process-wide
# variable cannot differ per project: add it in Settings → Agent accounts and pick it per project,
# and the two accounts can then be used side by side.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# OpenCode has no single home variable. It keeps CONFIG under $OPENCODE_CONFIG_DIR, falling back
# to $XDG_CONFIG_HOME/opencode and then ~/.config/opencode, but its CREDENTIALS live separately in
# ~/.local/share/opencode. xezar honours the config variable — prefer it over XDG_CONFIG_HOME,
# which is machine-wide and would relocate every other XDG-aware tool in the process.
# OPENCODE_CONFIG_DIR=~/.config/opencode
# pi keeps its whole per-user home — settings, models AND auth.json — under one variable, so it can
# carry a second account the way Claude and Codex can (re-verified against pi 0.85.1, 2026-09-12,
# #329). PI_CODING_AGENT_SESSION_DIR moves session storage alone and is deliberately not read by
# xezar: a dir with no credentials in it is not an account.
# PI_CODING_AGENT_DIR=~/.pi/agent

# Claude’s own model override. It outranks Claude settings files and supplies the native
# default the cockpit pre-fills. A saved cockpit preset or a model picked for a task
# still wins: xezar passes it as --model, unless models are locked (XEZ_AGENT_MODELS_LOCKED).
# ANTHROPIC_MODEL=claude-opus-4-6

# Claude denies tools that require approval instead of interrupting a headless run. Set to 1
# to opt back into Claude's interactive approval UI (`acceptEdits`).
# XEZ_APPROVAL_GATE=1

# Codex runs with full tool access by default. Set to 0 to opt into its network-blocked
# workspace-write sandbox.
# XEZ_CODEX_NETWORK=0

# Lock model selection to the defaults in native Claude/Codex/OpenCode/pi settings.
# Existing `.xezar/config.json` model presets are preserved but ignored while locked.
# `"modelsLocked": true` in global `~/.xezar/config.json` or a repository's
# `.xezar/config.json` enables the same policy.
# The project key is also the Settings → Agents "Lock models" switch and an MCP
# `project_config` write; turning it off deletes the key and never lifts this variable.
# Exact `1` also delegates provider authentication/enablement to the native
# agents: Xezar skips its credential probes and provider-disable preferences,
# while Claude/Codex/OpenCode/pi runner selection remains available.
# XEZ_AGENT_MODELS_LOCKED=1

# ---- project folders --------------------------------------------------------
# Zero-config defaults for the two independent Add project folders. Saved values in Global
# Settings → Projects override these defaults. The browse root must already exist; missing
# checkout folders are created recursively when saved and when a clone starts.
# XEZ_BROWSE_ROOT=~/
# XEZ_PROJECTS_DIR=~/xezar/projects

# ---- cockpit port and terminal output (#467) --------------------------------
# The port `xezar` starts from. Without -p/--port and without this, it starts from the port
# this project chose (`xezar projects port <id> <port>`), then the port it last listened on,
# then 4321 — and takes the next free port from there either way. A flag beats this variable,
# and a port pinned for the project beats it too: a XEZ_PORT exported once in a shell profile
# must not pull every project to the same start port. A value that is not a whole number from
# 0 to 65535 refuses the start with exit 1, before anything is claimed. `--port 0` asks the OS
# for any free port and is never remembered.
# XEZ_PORT=4321

# How `xezar serve` presents its activity: auto (the default), lines, rich. A saved
# `cli.output` in ~/.xezar/config.json overrides this variable; a --output flag overrides both.
#
# What each one does. `auto` draws a live table of active tasks on a terminal at least 60
# columns wide, drops to one line per event on a narrower one, and writes plain lines with no
# escape byte at all when the output is a file, a pipe, CI (a non-empty CI) or TERM=dumb.
# `lines` never draws a table, anywhere — that is the screen-reader and log-file answer.
# `rich` asks for the table. On a file, a pipe, CI or TERM=dumb it is refused with one
# `output.fallback` notice and plain lines follow: no request can put a cursor movement into a
# log file. On a terminal narrower than 60 columns it gives one line per event, with no notice. All of it goes to stderr; the boot
# banner and the cockpit URL stay on stdout, unchanged, so `xezar serve | tee` still works.
# XEZ_OUTPUT=auto

# Colour: auto (the default), always, never. NO_COLOR with any non-empty value is honoured and
# ranks above a saved `cli.color` and above XEZ_COLOR; an explicit --color beats NO_COLOR; and
# byte-exact transports beat all of them: MCP stdout, and serve output in a pipe, CI or
# TERM=dumb. Even `lines` with `always` stays escape-free there.
# XEZ_COLOR=auto
# NO_COLOR=1

# Diagnostic threshold: debug, info (the default), warn, error. A saved `cli.logLevel`
# overrides this variable; a --log-level flag overrides both.
# XEZ_LOG_LEVEL=info

# Warnings and errors only. Exact 1 enables it, like every other 0/1 flag here; --quiet is the
# flag. It raises the threshold but never lowers one you set higher. Serve has no live region
# or recovery notice in quiet mode; the actual cockpit URL remains visible.
# XEZ_QUIET=1

# Which projects one xezar process serves: workspace (the default — this cockpit opens every
# project you have registered) or project (this cockpit serves the project it started in, and
# your other projects appear as links to their own cockpit). A saved `cli.instance` in
# ~/.xezar/config.json overrides this variable; an --instance flag overrides both. A value that
# is neither word refuses the start with exit 1, before anything is claimed. XEZ_SINGLE_PROJECT
# and a folder that owns its xezar state already serve one project, and they win over this
# variable — it is then ignored, and an explicit `workspace` says so in one line.
# XEZ_INSTANCE=workspace

# Unchanged by #467: XEZ_NO_BANNER (below) still skips the skills banner, and
# XEZ_SINGLE_PROJECT (below) still keeps its exact meaning.

# ---- local state and startup UI ---------------------------------------------
# Override xezar's global state directory (default: `~/.xezar`). Useful for isolated test or
# container installs; an empty value deliberately falls back to the default. This home holds
# `config.json` — the per-user workspace config (parallel cap, memory ceiling, project roots)
# and the project registry every repo xezar boots in registers itself into — so two cockpits
# started with different XEZ_HOME values serve disjoint sets of projects. Missing, corrupt or
# read-only: xezar falls back to defaults and keeps running.
# Since 0.16.0 (#600) this variable relocates the GLOBAL state root and only that. In
# single-project ROOT mode — a folder holding `.xezar/workspace.json`, created by
# `xez --single-project` — the workspace config, the agent accounts and the workspace GUI
# state live in that folder instead and this variable is not consulted for them: the folder
# outranks the environment, by design, because a variable can be lost by a plain `xez`, an
# IDE or a script. The host-install records (`server.json`, `server-instances/`, the install
# lock) stay under this home in both layouts — they describe the machine, not the project.
# XEZ_HOME=/path/to/xezar-state

# Apply updates for tracked qodeca/xezar-skills installations automatically. On by default;
# set to 0 to stop automatic application (background detection still runs, read-only).
# A saved Skills setting overrides this environment default.
# XEZ_SKILLS_AUTO_UPDATE=0
# New Task defaults. Exact 0/1 only; workspace Settings overrides these seeds.
# XEZ_AUTONOMOUS_DEFAULT=0
# XEZ_WORKTREE_DEFAULT=1

# Dangerous escape hatch for any run executing in the repository root, including an
# explicit worktree opt-out, non-Git degradation, or a continuation whose worktree
# cannot be restored. Only the exact value 1 bypasses the repository-root lease.
# Concurrent agents may overwrite each other's files or Git state; isolated worktrees
# are unaffected. Off by default.
# XEZ_DISABLE_REPO_LOCK=1

# Opt into a launch-project-only cockpit. Only the exact value 1 enables this mode
# (`true`, `yes`, and every other value leave the default multi-project workspace on).
# While enabled, xezar exposes only the repo it was launched in and refuses project add,
# edit, checkout, browse, and remove operations. Registry rows are retained: unset the
# variable and restart to restore the full workspace without migration or data loss.
# This variable keeps that exact meaning and is NOT deprecated. It is a different thing
# from single-project ROOT mode (the `--single-project` flag, #600), which moves WHERE the
# state lives: this variable narrows the registry and leaves the state global; that flag
# puts the settings, accounts and registry in <project>/.xezar and never opens ~/.xezar.
# Either, both, or neither. No environment variable can turn that mode on — the folder does.
# XEZ_SINGLE_PROJECT=1

# Ask for the GLOBAL layout on this launch, even in a folder that carries the single-project
# marker `.xezar/workspace.json`. Only the exact value 1 does it, the same strict activation
# XEZ_SINGLE_PROJECT uses. It is the counterpart of `--single-project` (`--global-layout` is the
# flag): that one turns the single-project layout ON, and this one is the explicit answer that
# turns it OFF for one launch. It outranks the marker, so it is how a script or a test harness
# gets the global layout from a clone that commits `.xezar/workspace.json` without moving or
# renaming the project's own state. XEZ_HOME keeps its own meaning here: it relocates the global
# state root, and it neither turns the layout on nor off.
# XEZ_GLOBAL_LAYOUT=1

# Hide token counts or backend-reported cost independently throughout the browser
# cockpit. The legacy XEZ_HIDE_TOKEN_METRICS master switch hides both. Only the exact
# value 1 enables any presentation-only mode; telemetry and API payloads are preserved.
# Restart xezar after changing these flags.
# XEZ_HIDE_TOKEN_USAGE=1
# XEZ_HIDE_COST=1
# XEZ_HIDE_TOKEN_METRICS=1

# Skip the qodeca/xezar-skills banner printed by `xezar serve`.
# XEZ_NO_BANNER=1

# ---- follow-up inbox --------------------------------------------------------
# Off by default. Set to 1 to turn the global follow-up inbox back on: agents are then asked
# to leave follow-ups in `.local/xezar/todos.json` when they finish, the Inbox view reappears in
# the cockpit, and the composer offers a per-task toggle. Left off, agents are never asked and
# the Inbox is hidden — the per-task handoff journal ("Notes") is a separate feature and always
# runs. Existing todos.json entries are kept either way, so this is safe to flip back and forth.
# XEZ_FOLLOWUPS=1
# The browser suite exercises the default-off route. To also exercise the enabled inbox in a
# fresh shared test environment, run: `XEZ_FOLLOWUPS=1 npm run test:e2e -- --force`.
#
# This variable is now only the DEFAULT: Settings → Resources → "Follow-up Inbox" stores the
# choice in `~/.xezar/config.json` (`followups`), which wins whenever it is set and takes effect
# without a restart. "Follow XEZ_FOLLOWUPS" in that control clears the stored key back to this
# variable.

# ---- GitHub automations -----------------------------------------------------
# Off by default. Set to 1 to turn GitHub automations on: the Automations view appears in the
# cockpit, its endpoints answer, and xezar polls GitHub on each enabled automation's interval
# while it is running. Only the exact value 1 enables it (`true`, `yes`, and every other value
# leave it off). It is read live rather than at boot: turning it on in the environment the
# running process reads starts the poller as well as opening the routes, and turning it off
# again stops the poller and closes them — no restart either way. The change is observed the
# next time xezar consults the flag (saving a definition, adding or removing a project), so it
# is not instantaneous. Left off, nothing polls GitHub and no task is ever launched from it.
# Automation definitions, receipts and their
# frozen high-watermarks are kept either way, so this is safe to flip back and forth.
# XEZ_AUTOMATIONS=1
# The browser suite exercises the default-off route. To also exercise enabled automations in a
# fresh shared test environment, run: `XEZ_AUTOMATIONS=1 npm run test:e2e -- --force`.

# ---- task auto-naming ---------------------------------------------------------
# Short LLM-generated task titles (spec 2026-07-17-task-auto-naming). On by default.
# XEZ_TITLE_UPDATES=0 turns off the live per-turn title refresh (the Settings → Agents
# toggle, when set, wins over this env default). XEZ_AUTONAME=0 is the kill-switch for
# ALL LLM naming — creation-time and live — leaving only the heuristic titles. Under
# XEZ_DRY_RUN=1 naming is off by default (mock titles would clobber honest heuristics);
# XEZ_AUTONAME=1 forces it there — used by the test suite.
# XEZ_TITLE_UPDATES=0
# XEZ_AUTONAME=0

# ---- review gate -------------------------------------------------------------
# Optional diff-first review gate (pre-rename issue 489). OFF by default: a successful run with
# changes settles straight to `done`, leaving the diff in the worktree. Set
# XEZ_REVIEW_GATE=1 to make a changed non-autonomous run park at `review` for a
# human to Accept / Send back / open a Draft PR. Only the exact string "1"
# enables it ("true"/"yes" are treated as off). The Settings → Agents toggle,
# when set, wins over this env default. Autonomous runs ALWAYS skip the gate.
# XEZ_REVIEW_GATE=1

# ---- periodic autosave -------------------------------------------------------
# Off by default. Set to 1 to re-enable the janitor-style "xezar autosave" commit every 90 s
# in each task worktree (spec 006). Left off, a task branch carries only the agent's own
# commits — plus the turn-end and pre-PR flushes, which always run so the branch still ends
# holding the finished state and the diff/review/PR views stay complete. Those flushes commit
# as `xezar autosave (turn end|run finalize|pre-PR)`; only `(periodic)` is this flag's timer.
# XEZ_AUTOSAVE=1

# ---- agent process environment ----------------------------------------------
# Spawned agents get a least-privilege environment by default, not your full one: a
# base allowlist of non-secret shell/toolchain vars, the chosen backend's own auth
# vars, GITHUB_TOKEN, xezar's own XEZ_* namespace and the per-run env. Everything
# else — notably arbitrary secrets — is dropped. Both escape hatches are off by
# default and are read from the host environment.
#
# Forward these extra named host vars to the agent as well (comma-separated).
# XEZ_ENV_PASSTHROUGH=MY_VAR,OTHER_VAR
# This variable is now only the DEFAULT: Settings → Resources → "Extra variables agents receive"
# stores the list in `~/.xezar/config.json` (`agentEnvPassthrough`), which wins whenever it is set
# — including an empty list, a real "forward nothing" — and applies to the next task with no
# restart. "Follow XEZ_ENV_PASSTHROUGH" in that control clears the stored key back to this
# variable. Names only: the values still come from this machine's environment.
#
# Restore the legacy behaviour and hand the agent the full host environment. Only set
# this if you accept that it gives the agent process every secret in your environment.
# XEZ_AGENT_ENV_FULL=1

# Each run normally gets its own temp directory — TMPDIR/TEMP/TMP point at
# `.local/xezar/tmp/<task-id>`, which is created and write-probed before the backend
# spawns, so a run that cannot get a working temp directory fails with a named error
# instead of running blind. Set 0 to opt out of BOTH the per-run directory and the
# preflight, handing agents the host TMPDIR again.
# XEZ_AGENT_TMPDIR=0

# ---- secret redaction --------------------------------------------------------
# Credential values and well-known token shapes are scrubbed out of the on-disk state
# (the NDJSON transcript and the free-text fields of `runs.json`) before it is written.
# On by default; leave it on. It is best-effort defence in depth, not a guarantee.
# XEZ_REDACT_SECRETS=0

# ---- GitHub -----------------------------------------------------------------
# Used for the GitHub tab / PR actions. The `gh` CLI's own auth is preferred; set
# this only if you drive git/gh through a token instead.
# GITHUB_TOKEN=ghp_xxx

# ---- cockpit bundle (build time) --------------------------------------------
# Where the cockpit's JS should look for the API. Empty (the default) means "the origin that
# served this page", and that is right in BOTH normal cases: the bundled cockpit is served by the
# CLI itself, and `npm run dev` proxies `/api` (including the `/api/v1/ws` upgrade) from the Vite
# dev server to the local service — so a relative path already reaches localhost either way, and
# setting this in development would only bypass the proxy.
# Set it only when the bundle is deployed apart from the service it talks to. A deployment that
# must be configured without a rebuild can instead put `<meta name="xez-api-base" content="…">`
# in the served HTML, which wins over this.
# VITE_XEZ_API_BASE=http://localhost:4321

# ---- testing / internal -----------------------------------------------------
# Run agents against a mock CLI (no real model calls) — used by the test suite.
# XEZ_DRY_RUN=1

# XEZ_MOCK_ARGS_FILE=/tmp/xez-mock-args.json
# How far out the mock CLI's `mock:limit` reply puts its usage-limit reset (seconds, default 60),
# so a XEZ_DRY_RUN=1 session can exercise auto-resume without waiting for a real window.
# XEZ_MOCK_LIMIT_RESET_SECONDS=60
# Record every message the mock CLI receives (full text + image count, one JSON line each) to this file.
# XEZ_MOCK_STDIN_FILE=/tmp/xez-mock-stdin.txt
# Allow a real terminal spawn from inside a vitest run — the deliberate exception for
# the one test that exercises the launcher itself.
# XEZ_ALLOW_TEST_SPAWN=1
# Point `scripts/release.mjs` at a different repository root (its own tests use this).
# XEZ_RELEASE_ROOT=/path/to/checkout

# The following are set by xezar for child agent processes; you should not set them:
#   XEZ_TASK_ID, XEZ_STEP_ID, XEZ_HANDOFF_FILE, XEZ_TODOS_FILE
# XEZ_STEP_ID names the workflow step the agent is running as, and is empty when there is no step.

# Owner-run manual MCP test only: all three values come from the operator environment; missing any skips.
# XEZ_REAL_MODEL_BASE_URL=http://127.0.0.1:18000/v1
# Model id for the owner-run manual leg; no runtime behavior is changed. The harness wants the bare
# model id (pi adds its provider prefix).
# XEZ_REAL_MODEL_ID=deepseek-v4-flash-vision
# Required operator-supplied bearer key; missing key or HTTP 401/403 probe => NOT-RUN, never a model failure.
# XEZ_REAL_MODEL_API_KEY=
# Owner-run manual MCP test only (#67): comma list of clients whose real-model leg runs with the
# client's OWN configured login and model (paid usage). Unset => both legs skip as NOT-RUN.
# XEZ_REAL_MODEL_CLIENTS=claude-code,codex
# Claude Code model alias for that leg; default sonnet.
# XEZ_REAL_MODEL_CLAUDE_MODEL=sonnet
