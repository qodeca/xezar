{
  // Typecheck-only view of the server: the build config plus the test files it excludes,
  // plus the vitest workspace root config. Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // The api-client drift guards (api-types.test.ts, tool-display-mirror.test.ts) read that
    // package's SOURCE, so they name the real `.ts` files. Safe only here: this config never
    // emits, and nothing under `src/` that ships is allowed to import a `.ts` path.
    "allowImportingTsExtensions": true
  },
  // `scripts/pi-leader-extension.ts` ships as SOURCE — pi loads extensions through jiti, so it is
  // never compiled into `dist` and the build config (`rootDir: "src"`) cannot see it. It is named
  // here so the repository still typechecks it: a shipped file nothing typechecks is a file that
  // breaks in someone else's editor, not in CI.
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/pi-leader-extension.ts", "vitest.config.ts", "vitest.mutation.config.ts"],
  "exclude": []
}
