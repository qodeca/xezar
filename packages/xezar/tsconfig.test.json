{
  // Typecheck-only view of the server: the build config plus the test files it excludes,
  // plus the vitest workspace root config. Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // Repeated from the build config so this typecheck-only view states it on its own: imports
    // name the real `.ts` files. Safe here because this config never emits.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "vitest.mutation.config.ts", "vitest.mutation.lock.config.ts"],
  "exclude": []
}
